# Contact form (optional) — until these are set, the form shows a graceful
# "not wired to an inbox yet" message instead of failing.
# Get a key at https://resend.com
RESEND_API_KEY=
# Where contact submissions are delivered:
CONTACT_TO_EMAIL=
# Optional custom From address (must be a Resend-verified domain).
# Defaults to onboarding@resend.dev for testing.
CONTACT_FROM_EMAIL=
